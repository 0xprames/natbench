{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xprames/natbench/blob/main/schemas/transport-comparison-report-v1.schema.json",
  "title": "Transport comparison report version 1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "transport_comparison_report"
    },
    "topology": {
      "const": "ipv4_client_a_to_wan"
    },
    "workload_semantics": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "required": [
        "natbench_version",
        "os",
        "architecture",
        "kernel_release",
        "effective_uid",
        "recorded_at_unix_seconds"
      ],
      "additionalProperties": true
    },
    "planned": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "run": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "case": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "artifacts_directory": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "index",
          "run",
          "case",
          "adapter",
          "artifacts_directory"
        ],
        "additionalProperties": true
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "enum": [
              "passed",
              "transport_failed",
              "unsupported",
              "infrastructure_failed",
              "interrupted"
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation": {
            "anyOf": [
              {
                "$ref": "#/$defs/implementation"
              },
              {
                "type": "null"
              }
            ]
          },
          "measurement": {
            "anyOf": [
              {
                "$ref": "#/$defs/measurement"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "index",
          "outcome",
          "messages",
          "implementation",
          "measurement"
        ],
        "additionalProperties": true
      }
    },
    "active_attempt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "interrupted": {
      "type": "boolean"
    },
    "summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "requested_runs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "outcomes": {
            "type": "object",
            "properties": {
              "passed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "transport_failed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "unsupported": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "infrastructure_failed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "interrupted": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "additionalProperties": true
          },
          "unreported_runs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "first_data_seconds": {
            "anyOf": [
              {
                "$ref": "#/$defs/timing"
              },
              {
                "type": "null"
              }
            ]
          },
          "message_rtt_seconds": {
            "anyOf": [
              {
                "$ref": "#/$defs/timing"
              },
              {
                "type": "null"
              }
            ]
          },
          "bulk_bytes_per_second": {
            "anyOf": [
              {
                "$ref": "#/$defs/timing"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "case",
          "adapter",
          "requested_runs",
          "outcomes",
          "unreported_runs",
          "first_data_seconds",
          "message_rtt_seconds",
          "bulk_bytes_per_second"
        ],
        "additionalProperties": true
      }
    },
    "case_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "profile": {
            "enum": [
              "preserve",
              "random",
              "udp-blocked"
            ]
          },
          "network": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "client_to_server": {
                    "$ref": "#/$defs/conditions"
                  },
                  "server_to_client": {
                    "$ref": "#/$defs/conditions"
                  }
                },
                "required": [
                  "client_to_server",
                  "server_to_client"
                ],
                "additionalProperties": true
              }
            ]
          }
        },
        "required": [
          "name",
          "profile",
          "network"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "topology",
    "workload_semantics",
    "environment",
    "planned",
    "attempts",
    "active_attempt",
    "complete",
    "interrupted",
    "summaries"
  ],
  "additionalProperties": true,
  "$defs": {
    "timing": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "mean": {
          "type": "number",
          "minimum": 0
        },
        "median": {
          "type": "number",
          "minimum": 0
        },
        "p95": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "samples",
        "min",
        "max",
        "mean",
        "median",
        "p95"
      ],
      "additionalProperties": true
    },
    "measurement": {
      "type": "object",
      "properties": {
        "workload": {
          "$ref": "#/$defs/workload"
        },
        "path": {
          "const": "direct"
        },
        "path_evidence": {},
        "first_data_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "message_rtt_seconds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60
          }
        },
        "bulk_verified_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        },
        "bulk_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        }
      },
      "required": [
        "workload",
        "path",
        "path_evidence",
        "first_data_seconds",
        "message_rtt_seconds",
        "bulk_verified_bytes",
        "bulk_seconds"
      ],
      "additionalProperties": true
    },
    "workload": {
      "type": "object",
      "properties": {
        "payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "warmup_messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "measured_messages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "bulk_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        }
      },
      "required": [
        "payload_bytes",
        "warmup_messages",
        "measured_messages",
        "bulk_bytes"
      ],
      "additionalProperties": true
    },
    "implementation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "version",
        "settings"
      ],
      "additionalProperties": true
    },
    "conditions": {
      "type": "object",
      "properties": {
        "delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "loss_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "delay_ms",
        "loss_percent"
      ],
      "additionalProperties": true
    }
  }
}
