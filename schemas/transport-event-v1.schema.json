{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xprames/natbench/blob/main/schemas/transport-event-v1.schema.json",
  "title": "Transport executable event version 1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "transport_event"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{32}$"
    },
    "implementation": {
      "$ref": "#/$defs/implementation"
    },
    "event": {
      "enum": [
        "ready",
        "completed",
        "failed",
        "unsupported"
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "implementation",
    "event"
  ],
  "additionalProperties": true,
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "ready"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "event",
        "capabilities"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "completed"
        },
        "measurement": {
          "$ref": "#/$defs/measurement"
        }
      },
      "required": [
        "event",
        "measurement"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "failed"
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "event",
        "phase",
        "message"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "unsupported"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "event",
        "reason"
      ],
      "additionalProperties": true
    }
  ],
  "$defs": {
    "workload": {
      "type": "object",
      "properties": {
        "payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "warmup_messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "measured_messages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "bulk_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        }
      },
      "required": [
        "payload_bytes",
        "warmup_messages",
        "measured_messages",
        "bulk_bytes"
      ],
      "additionalProperties": true
    },
    "implementation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "version",
        "settings"
      ],
      "additionalProperties": true
    },
    "measurement": {
      "type": "object",
      "properties": {
        "workload": {
          "$ref": "#/$defs/workload"
        },
        "path": {
          "const": "direct"
        },
        "path_evidence": {},
        "first_data_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "message_rtt_seconds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60
          }
        },
        "bulk_verified_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        },
        "bulk_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        }
      },
      "required": [
        "workload",
        "path",
        "path_evidence",
        "first_data_seconds",
        "message_rtt_seconds",
        "bulk_verified_bytes",
        "bulk_seconds"
      ],
      "additionalProperties": true
    }
  }
}
