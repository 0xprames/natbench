{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/0xprames/natbench/main/schemas/scenario-v3.schema.json",
  "title": "natbench application scenario version 3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "a",
        "b",
        "router_input",
        "processes",
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "a": {
          "enum": [
            "preserve",
            "random",
            "udp-blocked"
          ]
        },
        "b": {
          "enum": [
            "preserve",
            "random",
            "udp-blocked"
          ]
        },
        "router_input": {
          "enum": [
            "drop",
            "accept"
          ]
        },
        "processes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/program"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "process"
                ],
                "properties": {
                  "action": {
                    "const": "start"
                  },
                  "process": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "process"
                ],
                "properties": {
                  "action": {
                    "const": "run"
                  },
                  "process": {
                    "type": "string"
                  },
                  "expect_exit": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 255
                  },
                  "stdout_contains": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "process"
                ],
                "properties": {
                  "action": {
                    "const": "stop"
                  },
                  "process": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "process"
                ],
                "properties": {
                  "action": {
                    "const": "restart"
                  },
                  "process": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "process",
                  "text",
                  "timeout_seconds"
                ],
                "properties": {
                  "action": {
                    "const": "wait_stdout"
                  },
                  "process": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "timeout_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 3600
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "process",
                  "timeout_seconds"
                ],
                "properties": {
                  "action": {
                    "const": "wait_exit"
                  },
                  "process": {
                    "type": "string"
                  },
                  "timeout_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 3600
                  },
                  "expect_exit": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 255
                  },
                  "stdout_contains": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "seconds"
                ],
                "properties": {
                  "action": {
                    "const": "delay"
                  },
                  "seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 3600
                  }
                }
              }
            ]
          }
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "argv",
        "timeout_seconds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "role": {
          "enum": [
            "a",
            "b",
            "ra",
            "rb",
            "wan"
          ]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "cwd": {
          "type": "string",
          "default": "."
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ready": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "text"
              ],
              "properties": {
                "kind": {
                  "const": "stdout_contains"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "address"
              ],
              "properties": {
                "kind": {
                  "const": "tcp"
                },
                "address": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    }
  }
}
