{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xprames/natbench/blob/main/schemas/transport-comparison-v1.schema.json",
  "title": "Matched direct transport comparison input version 1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "transport_comparison"
    },
    "adapters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "argv"
        ],
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "enum": [
              "preserve",
              "random",
              "udp-blocked"
            ]
          },
          "deadline_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000
          },
          "workload": {
            "$ref": "#/$defs/workload"
          }
        },
        "required": [
          "name",
          "profile",
          "deadline_ms",
          "workload"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "adapters",
    "cases"
  ],
  "additionalProperties": false,
  "$defs": {
    "workload": {
      "type": "object",
      "properties": {
        "payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "warmup_messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "measured_messages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "bulk_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        }
      },
      "required": [
        "payload_bytes",
        "warmup_messages",
        "measured_messages",
        "bulk_bytes"
      ],
      "additionalProperties": false
    }
  }
}
