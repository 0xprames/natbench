{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/0xprames/natbench/main/schemas/suite-report-v2.schema.json",
  "title": "natbench suite report version 2",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "cases",
    "planned_cases",
    "active_case",
    "complete",
    "interrupted"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "scenario": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case_report"
      }
    },
    "planned_cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "active_case": {
      "type": [
        "string",
        "null"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "interrupted": {
      "type": "boolean"
    }
  },
  "$defs": {
    "case_report": {
      "type": "object",
      "required": [
        "name",
        "status",
        "messages",
        "observation"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "assertion_failed",
            "inconclusive",
            "infrastructure_failed"
          ]
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observation": {},
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Optional complete-case wall time, including fixture setup and teardown, in seconds."
        }
      }
    }
  }
}
