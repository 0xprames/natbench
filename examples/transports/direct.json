{
  "schema_version": 1,
  "kind": "transport_comparison",
  "adapters": [
    {
      "name": "iroh",
      "argv": [
        "./target/release/natbench-transport-adapters",
        "--transport",
        "iroh"
      ]
    },
    {
      "name": "quinn",
      "argv": [
        "./target/release/natbench-transport-adapters",
        "--transport",
        "quinn"
      ]
    },
    {
      "name": "tcp",
      "argv": [
        "./target/release/natbench-transport-adapters",
        "--transport",
        "tcp"
      ]
    }
  ],
  "cases": [
