        "measured_messages": 10,
        "bulk_bytes": 1048576
      }
    },
    {
      "name": "direct stream behind random NAT",
      "profile": "random",
      "deadline_ms": 5000,
      "workload": {
        "payload_bytes": 128,
        "warmup_messages": 3,
        "measured_messages": 10,
        "bulk_bytes": 1048576
